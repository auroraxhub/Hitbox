-- // 6. SILENT AIM PURO (hook __index: seguro, no crashea)
local mt = getrawmetatable(game)
local oldIndex = getgenv().oldIndex or mt.__index
getgenv().oldIndex = oldIndex

local indexHook = newcclosure(function(self, key)
    if getgenv().AimbotEnabled and not checkcaller() then
        if key == "Hit" or key == "Target" then
            local target = GetClosestTarget()
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                if key == "Hit" then
                    return target.Character.HumanoidRootPart.CFrame
                elseif key == "Target" then
                    return target.Character.HumanoidRootPart
                end
            end
        end
    end
    return oldIndex(self, key)
end)

setreadonly(mt, false)
mt.__index = indexHook
setreadonly(mt, true)

-- Guardián: reaplica el hook si el juego lo resetea
task.spawn(function()
    while task.wait(2) do
        local currMt = getrawmetatable(game)
        if currMt.__index ~= indexHook then
            setreadonly(currMt, false)
            currMt.__index = indexHook
            setreadonly(currMt, true)
        end
    end
end)

-- // 7. ESP BOX 2D (4 líneas, anclado al torso, SIN DELAY)
local function CreateBoxESP(player)
    local lines = {
        Top = Drawing.new("Line"),
        Bottom = Drawing.new("Line"),
        Left = Drawing.new("Line"),
        Right = Drawing.new("Line")
    }

    for _, line in pairs(lines) do
        line.Thickness = 1.5
        line.Visible = false
    end
    getgenv().ESPDrawings[player.Name] = lines

    RunService.RenderStepped:Connect(function()
        if not getgenv().ESPEnabled or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") or not player.Character:FindFirstChild("Humanoid") or player.Character.Humanoid.Health <= 0 then
            for _, line in pairs(lines) do line.Visible = false end
            return
        end

        local cam = workspace.CurrentCamera
        local hrp = player.Character.HumanoidRootPart

        local top3D = hrp.Position + Vector3.new(0, 3.5, 0)
        local bottom3D = hrp.Position - Vector3.new(0, 3, 0)

        local top2D, onScreenTop = cam:WorldToViewportPoint(top3D)
        local bottom2D, onScreenBot = cam:WorldToViewportPoint(bottom3D)

        if onScreenTop and onScreenBot then
            local height = math.abs(top2D.Y - bottom2D.Y)
            local width = height * 0.6

            local centerX = (top2D.X + bottom2D.X) / 2
            local centerY = (top2D.Y + bottom2D.Y) / 2

            local tl = Vector2.new(centerX - width / 2, centerY - height / 2)
            local tr = Vector2.new(centerX + width / 2, centerY - height / 2)
            local bl = Vector2.new(centerX - width / 2, centerY + height / 2)
            local br = Vector2.new(centerX + width / 2, centerY + height / 2)

            local color = Color3.fromHSV(tick() % 3 / 3, 1, 1)

            lines.Top.From = tl; lines.Top.To = tr; lines.Top.Color = color; lines.Top.Visible = true
            lines.Bottom.From = bl; lines.Bottom.To = br; lines.Bottom.Color = color; lines.Bottom.Visible = true
            lines.Left.From = tl; lines.Left.To = bl; lines.Left.Color = color; lines.Left.Visible = true
            lines.Right.From = tr; lines.Right.To = br; lines.Right.Color = color; lines.Right.Visible = true
        else
            for _, line in pairs(lines) do line.Visible = false end
        end
    end)
end

for _, v in pairs(Players:GetPlayers()) do
    if v ~= LocalPlayer then CreateBoxESP(v) end
end
Players.PlayerAdded:Connect(function(v) CreateBoxESP(v) end)
Players.PlayerRemoving:Connect(function(v)
    if getgenv().ESPDrawings[v.Name] then
        for _, line in pairs(getgenv().ESPDrawings[v.Name]) do line:Remove() end
        getgenv().ESPDrawings[v.Name] = nil
    end
end)
