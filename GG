local ScreenGui = Instance.new("ScreenGui", CoreGui)
ScreenGui.Name = "MVS_Pro_UI"
ScreenGui.IgnoreGuiInset = true -- Ignora el notch del teléfono

local function createDraggableRainbowButton(text, position, onToggle)
    local Frame = Instance.new("Frame", ScreenGui)
    Frame.Size = UDim2.new(0, 130, 0, 45)
    Frame.Position = position
    Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    Frame.BorderSizePixel = 2
    Frame.Active = true

    local Btn = Instance.new("TextButton", Frame)
    Btn.Size = UDim2.new(1, 0, 1, 0)
    Btn.BackgroundTransparency = 1
    Btn.Text = text .. ": OFF"
    Btn.Font = Enum.Font.Code
    Btn.TextSize = 18

    local dragging, dragInput, dragStart, startPos
    local hasDragged = false

    Frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            hasDragged = false
            dragStart = input.Position
            startPos = Frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    Frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            if delta.Magnitude > 5 then hasDragged = true end
            Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    Btn.MouseButton1Click:Connect(function()
        if hasDragged then return end
        onToggle(Btn)
    end)

    RunService.RenderStepped:Connect(function()
        local hue = tick() % 3 / 3
        Frame.BorderColor3 = Color3.fromHSV(hue, 1, 1)
        Btn.TextColor3 = Color3.fromHSV(hue, 1, 1)
    end)

    return Btn
end

